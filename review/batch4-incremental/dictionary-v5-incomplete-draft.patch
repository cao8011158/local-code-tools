+"""Conservative, non-searchable evidence for one straight-line dictionary form.
+
+This inventory never resolves a call. It records supports only when the existing
+Analyzer has resolved the corresponding subscript and the structural certificate
+excludes other writes, escapes and control-flow paths.
+"""
+
+import ast
+
+from .common import canonical, digest
+
+
+def dictionary_shape(tree):
+    """Return exact local registry declarations/writes/reads, or None.
+
+    Only module-local string keys and direct callable definitions are admitted.
+    An empty dictionary is supported so a previously missing key is subscribed.
+    """
+    if not isinstance(tree, ast.Module):
+        return None
+    definitions = {}
+    for stmt in tree.body:
+        if isinstance(stmt, ast.FunctionDef):
+            if (stmt.name in definitions or stmt.decorator_list or stmt.args.args
+                    or stmt.args.posonlyargs or stmt.args.kwonlyargs or stmt.args.vararg
+                    or stmt.args.kwarg or stmt.args.defaults or stmt.args.kw_defaults
+                    or stmt.returns or any(not isinstance(s, ast.Pass) for s in stmt.body)
+                    and not _reader_body(stmt.body)):
+                return None
+            definitions[stmt.name] = stmt
+        elif not isinstance(stmt, ast.Assign):
+            return None
+    registries, writes, reads = {}, [], []
+    for stmt in tree.body:
+        if isinstance(stmt, ast.Assign):
+            if len(stmt.targets) != 1:
+                return None
+            target = stmt.targets[0]
+            if isinstance(target, ast.Name) and isinstance(stmt.value, ast.Dict):
+                if target.id in registries or target.id in definitions:
+                    return None
+                registries[target.id] = stmt.value
+                for key, value in zip(stmt.value.keys, stmt.value.values):
+                    if not _key(key) or not isinstance(value, ast.Name) or value.id not in definitions:
+                        return None
+                    writes.append((target.id, key.value, stmt, value.id, key))
+            elif isinstance(target, ast.Subscript) and isinstance(target.value, ast.Name):
+                if (target.value.id not in registries or not _key(target.slice)
+                        or not isinstance(stmt.value, ast.Name) or stmt.value.id not in definitions):
+                    return None
+                writes.append((target.value.id, target.slice.value, stmt, stmt.value.id, target.slice))
+            else:
+                return None
+        elif isinstance(stmt, ast.FunctionDef):
+            aliases = {}
+            for inner in stmt.body:
+                if isinstance(inner, ast.Pass):
+                    continue
+                if isinstance(inner, ast.Assign):
+                    if (len(inner.targets) != 1 or not isinstance(inner.targets[0], ast.Name)
+                            or not isinstance(inner.value, ast.Name)
+                            or inner.value.id not in registries):
+                        return None
+                    alias = inner.targets[0].id
+                    if alias in aliases or alias in registries or alias in definitions:
+                        return None
+                    aliases[alias] = inner.value.id
+                    continue
+                call = inner.value if isinstance(inner, ast.Expr) else None
+                if (not isinstance(call, ast.Call) or call.args or call.keywords
+                        or not isinstance(call.func, ast.Subscript)
+                        or not isinstance(call.func.value, ast.Name)
+                        or not _key(call.func.slice)):
+                    return None
+                name = call.func.value.id
+                registry = aliases.get(name, name)
+                if registry not in registries:
+                    return None
+                reads.append((registry, call.func.slice.value, stmt, call.func))
+    if not registries or not reads:
+        return None
+    return registries, writes, reads
+
+
+def _reader_body(body):
+    return all(isinstance(s, (ast.Pass, ast.Assign, ast.Expr)) for s in body)
+
+
+def _key(node):
+    return isinstance(node, ast.Constant) and type(node.value) is str
+
+
+def evidence(nodes, asts, analyzer, sites):
+    """Make private semantic nodes/relations only for witnessed analyzer reads."""
+    by_node = {n["node_id"]: n for n in nodes}
+    functions = {(n.get("parent"), n.get("name")): n["node_id"] for n in nodes
+                 if n["kind"] == "function"}
+    site_by_pos = {(s["execution_owner"], s["line"], s["column"]): s for s in sites}
+    records = {"nodes": [], "edges": [], "reads": []}
+    for module, tree in asts.items():
+        owner = by_node.get(module)
+        if not owner or owner["kind"] != "module":
+            continue
+        shape = dictionary_shape(tree)
+        if shape is None:
+            continue
+        registries, writes, reads = shape
+        definitions = {name: ident for (parent, name), ident in functions.items()
+                       if parent == module}
+        def ident(kind, *parts):
+            return "value:" + digest(canonical([owner["repository"], owner["path"],
+                                              owner["snapshot_id"], kind, *parts]))
+        containers = {name: ident("container", expr.lineno, expr.col_offset, name)
+                      for name, expr in registries.items()}
+        entries = {(name, key): ident("entry", containers[name], key)
+                   for name, key, *_ in writes + [(n, k, None, None, None) for n, k, *_ in reads]}
+        latest = {}
+        for name, expr in registries.items():
+            records["nodes"].append(dict(id=containers[name], kind="container", module=module,
+                                         name=name, line=expr.lineno, column=expr.col_offset))
+        for (name, key), entry in entries.items():
+            records["nodes"].append(dict(id=entry, kind="entry", container=containers[name],
+                                         key=key, module=module))
+            records["edges"].append(dict(source=containers[name], target=entry, kind="HAS_ENTRY"))
+        for name, key, stmt, target, key_ast in writes:
+            write = ident("write", stmt.lineno, stmt.col_offset, key_ast.col_offset)
+            records["nodes"].append(dict(id=write, kind="write", module=module,
+                                         line=stmt.lineno, column=stmt.col_offset,
+                                         target=definitions[target]))
+            records["edges"].extend((dict(source=write, target=entries[name, key], kind="WRITES"),
+                                     dict(source=write, target=definitions[target], kind="VALUE")))
+            latest[name, key] = write, definitions[target]
+        for name, key, fn, expr in reads:
+            call_site = site_by_pos.get((functions.get((module, fn.name)),
+                                         expr.lineno, expr.col_offset))
+            result = analyzer.value_reads.get((call_site["execution_owner"], expr.lineno,
+                                               expr.col_offset)) if call_site else None
+            expected = {latest[name, key][1]} if (name, key) in latest else set()
+            actual = {a.target for a in result.atoms if a.kind == "callable"} if result else set()
+            if call_site is None or result is None or actual != expected or result.reasons:
+                continue
+            read = ident("read", expr.lineno, expr.col_offset, key)
+            records["nodes"].append(dict(id=read, kind="read", module=module,
+                                         site_id=call_site["site_id"], line=expr.lineno,
+                                         column=expr.col_offset, unknown=bool(result.reasons),
+                                         targets=sorted(a.target for a in result.atoms
+                                                        if a.kind in ("callable", "method"))))
+            records["edges"].append(dict(source=read, target=entries[name, key], kind="READS"))
+            if (name, key) in latest:
+                records["edges"].append(dict(source=latest[name, key][0], target=read,
+                                             kind="REACHES"))
+            records["reads"].append(dict(producer_repository=owner["repository"],
+                                         producer_path=owner["path"], entry=entries[name, key],
+                                         consumer_repository=owner["repository"],
+                                         consumer_path=owner["path"], read=read))
+    return records
