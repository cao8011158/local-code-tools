+                uncertain = True
+            elif (isinstance(child, ast.Call) and isinstance(child.func, ast.Attribute)
+                  and child.func.attr in {"update", "clear", "pop", "popitem", "setdefault",
+                                          "__setitem__", "__delitem__", "append", "extend",
+                                          "insert", "remove", "add", "discard"}):
