{
  "data": "data",
  "include_tests": false,
  "retained_versions": 2,
  "retained_backups": 2,
  "repositories": [
    {
      "name": "agentic-trpg",
      "path": "C:/REPLACE_WITH_YOUR_WORKSPACE/agentic-trpg",
      "code_roots": [],
      "exclude_files": [
        "docs/FIRST_BLUSH_MVP_REQUIREMENTS.md"
      ]
    },
    {
      "name": "trpg-state-machine",
      "path": "C:/REPLACE_WITH_YOUR_WORKSPACE/trpg-state-machine",
      "code_roots": [
        "src",
        "examples",
        "scripts"
      ]
    },
    {
      "name": "trpg-rules-engine",
      "path": "C:/REPLACE_WITH_YOUR_WORKSPACE/trpg-rules-engine",
      "code_roots": [
        "packages/dnd5e-engine/src",
        "packages/dnd5e-srd-data/src",
        "packages/nat20-bridge/src",
        "apps/demo/src",
        "scripts",
        "examples"
      ]
    }
  ],
  "embedding": {
    "model": "voyage-code-4",
    "dimension": 1024,
    "dtype": "float",
    "endpoint": "https://api.voyageai.com/v1/embeddings",
    "price_per_million_usd": 0.12,
    "max_requests": 400,
    "max_estimated_tokens": 15000000,
    "max_cost_usd": 2,
    "batch_bytes": 70000,
    "batch_items": 64,
    "retries": 3,
    "min_interval_seconds": 1
  },
  "hnsw": {
    "connectivity": 32,
    "expansion_add": 128,
    "expansion_search": 128
  },
  "freshness": {
    "policy": "explicit inventory at build/status(refresh=true); retrieval reports last check time, never assumes fresh"
  }
}
